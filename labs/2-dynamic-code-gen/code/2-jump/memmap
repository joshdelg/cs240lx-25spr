/* you should modify this linker script  */
SECTIONS
{
    /*
     * cs107e uses this:
     *      .text 0x8000 :  { start.o(.text*)  *(.text*) } 
     * which makes linking in start.o awkward if you don't copy it into
     * each dir.
     *
     * XXX: I cannot make text.boot work if we link start into libpi.a 
     */
    .custom_header 0x8000 : {
        /* Branch instruction to skip header */
        LONG(0xea00000e);
        __hello_string__ = .;
        /* "hell" */
        LONG(0x6C6C6568);
        /* "o" + 0 terminator */
        LONG(0x6F);

        /* Pad to 64 bytes (already used 12) */
        /* . = . + 0x34; */
        . = ALIGN(64);
    }
    .text :  { KEEP(*(.text.boot))  *(.text*) }
    .data : { *(.data*) } 
    .rodata : { *(.rodata*) }
    .bss : {
        __bss_start__ = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(8);
        __bss_end__ = .;
        . = ALIGN(8);
        __heap_start__ = .;
    }
}
